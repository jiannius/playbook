{
    "name": "jiannius/playbook",
    "description": "The Jiannius engineering standard, and the machinery that installs and enforces it",
    "type": "library",
    "keywords": ["laravel", "standards", "guidelines", "boost"],
    "license": "MIT",
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "laravel/boost": "^2.4"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jiannius\\Playbook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Playbook\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Playbook\\PlaybookServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
